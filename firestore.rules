rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Server-minted custom claim check for designated admin with verified email
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.admin == true &&
        request.auth.token.email == "buildsafe247@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role in ['client', 'supplier']) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active');
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'isAdmin', 'status', 'emailVerified'])
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      // Saved subcollection
      match /saved/{savedId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (
        isSignedIn() && resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'isVerified'])
      ) || isAdmin();
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Listings subcollection
      match /listings/{listingId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && 
          (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid || isAdmin());
      }

      // Private Supplier Quotes subcollection
      match /quotes/{quoteId} {
        allow read, write: if isSignedIn() && 
          (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // Collection Group rule for public listings query across all businesses
    match /{path=**}/listings/{listingId} {
      allow read: if true;
    }

    // Standardized Catalogue Items (Platform owned)
    match /catalogItems/{catalogItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quote Requests
    match /quoteRequests/{quoteRequestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.clientId == request.auth.uid ||
        resource.data.supplierOwnerId == request.auth.uid ||
        (resource.data.supplierBusinessId != null && get(/databases/$(database)/documents/businesses/$(resource.data.supplierBusinessId)).data.ownerId == request.auth.uid) ||
        (resource.data.businessId != null && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.clientId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.clientId == request.auth.uid ||
        resource.data.supplierOwnerId == request.auth.uid ||
        (resource.data.supplierBusinessId != null && get(/databases/$(database)/documents/businesses/$(resource.data.supplierBusinessId)).data.ownerId == request.auth.uid) ||
        (resource.data.businessId != null && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reports / Audit logs
    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
